<UserControl
    x:Class="SerialWorkbench.WinUI.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="6">
    <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" />
    <TextBlock x:Name="DescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
