<UserControl
    x:Class="SerialWorkbench.WinUI.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border
      Padding="16,14"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon
          x:Name="Icon"
          FontFamily="Segoe Fluent Icons"
          FontSize="20"
          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
          Glyph="&#xE8A5;"
          HorizontalAlignment="Center"
          VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="DescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ContentPresenter x:Name="ActionContent" Grid.Column="2" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
