<Page x:Class="SerialWorkbench.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="{StaticResource ContentPageSpacing}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="PageMarginStates">
          <VisualState x:Name="CompactPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="StandardPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="641" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <toolkit:SettingsCard Header="工作区" Description="管理会话文件和工作区路径。" HorizontalContentAlignment="Stretch">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8B7;" />
        </toolkit:SettingsCard.HeaderIcon>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="WorkspacePath" x:FieldModifier="public"
              Text="尚未选择工作区"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap"
              VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="选择" Click="ChooseWorkspaceButton_Click" />
            <Button x:Name="ClearWorkspaceButton" Content="关闭" Click="ClearWorkspaceButton_Click" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </toolkit:SettingsCard>

      <toolkit:SettingsCard Header="外观" Description="选择应用主题，或跟随 Windows 设置。" HorizontalContentAlignment="Stretch">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE790;" />
        </toolkit:SettingsCard.HeaderIcon>
        <ComboBox x:Name="ThemeSelector" x:FieldModifier="public" HorizontalAlignment="Stretch" SelectionChanged="ThemeSelector_SelectionChanged">
          <x:String>跟随系统</x:String>
          <x:String>浅色</x:String>
          <x:String>深色</x:String>
        </ComboBox>
      </toolkit:SettingsCard>

      <toolkit:SettingsCard Header="关于 SerialWorkbench" Description="查看版本和运行环境信息。" HorizontalContentAlignment="Stretch">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE946;" />
        </toolkit:SettingsCard.HeaderIcon>
        <Grid ColumnSpacing="16" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="应用版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="AppVersion" Grid.Column="1" />
          <TextBlock Grid.Row="1" Text=".NET" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="DotnetVersion" Grid.Row="1" Grid.Column="1" />
          <TextBlock Grid.Row="2" Text="Windows App Runtime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="WindowsAppRuntimeVersion" Grid.Row="2" Grid.Column="1" />
          <TextBlock Grid.Row="3" Text="系统" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="SystemVersion" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
          <TextBlock Grid.Row="4" Text="运行目录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ApplicationPath" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
          <TextBlock Grid.Row="5" Text="许可证" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Apache License 2.0 · LICENSE" />
        </Grid>
      </toolkit:SettingsCard>
    </StackPanel>
  </ScrollView>
</Page>
