<Page x:Class="SerialWorkbench.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls"
    NavigationCacheMode="Required">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="{StaticResource ContentPageSpacing}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="PageMarginStates">
          <VisualState x:Name="CompactPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="StandardPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="641" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel Spacing="6">
        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="配置工作区、外观和应用行为。" Style="{StaticResource PageDescriptionStyle}" />
      </StackPanel>

      <controls:SettingsRow Title="工作区" Description="管理会话文件和工作区路径。" Glyph="&#xE8B7;">
        <controls:SettingsRow.Action>
          <Button x:Name="ChooseWorkspaceButton" x:FieldModifier="public" Content="选择" Click="ChooseWorkspaceButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
        </controls:SettingsRow.Action>
      </controls:SettingsRow>
      <TextBlock x:Name="WorkspacePath" x:FieldModifier="public"
          Text="尚未选择工作区"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis" />

      <controls:SettingsRow Title="外观" Description="选择应用主题，或跟随 Windows 设置。" Glyph="&#xE790;">
        <controls:SettingsRow.Action>
          <ComboBox x:Name="ThemeSelector" x:FieldModifier="public" Width="150" SelectionChanged="ThemeSelector_SelectionChanged">
            <x:String>跟随系统</x:String>
            <x:String>浅色</x:String>
            <x:String>深色</x:String>
          </ComboBox>
        </controls:SettingsRow.Action>
      </controls:SettingsRow>

      <controls:SettingsRow Title="关于 SerialWorkbench" Description="查看版本和运行环境信息。" Glyph="&#xE946;" />
    </StackPanel>
  </ScrollView>
</Page>
