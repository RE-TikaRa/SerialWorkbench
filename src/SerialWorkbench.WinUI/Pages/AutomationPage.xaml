<Page x:Class="SerialWorkbench.WinUI.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
  <ScrollView VerticalScrollBarVisibility="Auto">
    <Grid Padding="{StaticResource ContentPagePadding}" RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="12">
          <TextBox x:Name="SequenceName" Header="序列名称" Text="新建序列" />
          <TextBox x:Name="SequenceJson" Header="序列定义 JSON" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <InfoBar x:Name="Result" IsOpen="False" IsClosable="True" />
            <Button Grid.Column="1" Content="保存" Click="SaveButton_Click" />
            <Button Grid.Column="2" Content="取消" Click="CancelButton_Click" IsEnabled="False" />
            <Button x:Name="RunButton" Grid.Column="3" Content="运行" Click="RunButton_Click" Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="1" Text="每个步骤包含 data、format、delayMilliseconds、repeatCount、waitMilliseconds、responseHex、responseTimeoutMilliseconds 和 retryCount。data 与 responseHex 使用 HEX 字符串。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
  </ScrollView>
</Page>
