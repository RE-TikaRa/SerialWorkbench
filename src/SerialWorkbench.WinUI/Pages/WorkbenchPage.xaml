<Page
    x:Class="SerialWorkbench.WinUI.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls"
    xmlns:sp="using:ScottPlot.WinUI"
    NavigationCacheMode="Required">
  <Page.Resources>
    <Storyboard x:Name="MonitorViewTransition">
      <FadeInThemeAnimation TargetName="MonitorView" />
    </Storyboard>
    <Storyboard x:Name="PlotViewTransition">
      <FadeInThemeAnimation TargetName="PlotView" />
    </Storyboard>
  </Page.Resources>
  <Grid Padding="36,24,36,36" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" Title="接收" Description="连接串口并查看实时收到的数据。" />

    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
      <StackPanel Spacing="14">
        <TextBlock Text="串口连接" Style="{StaticResource SectionHeaderStyle}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="PortComboBox" x:FieldModifier="public" Header="端口" DisplayMemberPath="DisplayName" PlaceholderText="选择串口" HorizontalAlignment="Stretch" />
          <Button x:Name="RefreshPortsButton" x:FieldModifier="public" Grid.Column="1" Click="RefreshPortsButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Bottom" MinWidth="40" ToolTipService.ToolTip="刷新端口">
            <FontIcon Glyph="&#xE72C;" FontSize="16" />
          </Button>
          <ComboBox x:Name="BaudRateComboBox" x:FieldModifier="public" Grid.Column="2" Header="波特率" IsEditable="True" SelectedIndex="7" HorizontalAlignment="Stretch">
            <x:String>1200</x:String>
            <x:String>2400</x:String>
            <x:String>4800</x:String>
            <x:String>9600</x:String>
            <x:String>19200</x:String>
            <x:String>38400</x:String>
            <x:String>57600</x:String>
            <x:String>115200</x:String>
            <x:String>230400</x:String>
            <x:String>460800</x:String>
            <x:String>921600</x:String>
          </ComboBox>
          <ComboBox x:Name="MonitorFormat" x:FieldModifier="public" Grid.Column="3" Header="显示" SelectedIndex="0">
            <x:String>HEX</x:String>
            <x:String>文本</x:String>
          </ComboBox>
          <Button x:Name="ConnectButton" x:FieldModifier="public" Grid.Column="4" Content="连接" Click="ConnectButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock x:Name="ConnectionStatusText" Text="正在连接服务…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Expander x:Name="AdvancedExpander" x:FieldModifier="public" Header="高级参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="DataBitsNumberBox" x:FieldModifier="public" Header="数据位" Value="8" Minimum="5" Maximum="8" SpinButtonPlacementMode="Compact" />
            <ComboBox x:Name="ParityComboBox" x:FieldModifier="public" Grid.Column="1" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>奇校验</x:String>
              <x:String>偶校验</x:String>
              <x:String>标记</x:String>
              <x:String>空格</x:String>
            </ComboBox>
            <ComboBox x:Name="StopBitsComboBox" x:FieldModifier="public" Grid.Column="2" Header="停止位" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>1</x:String>
              <x:String>1.5</x:String>
              <x:String>2</x:String>
            </ComboBox>
            <ComboBox x:Name="HandshakeComboBox" x:FieldModifier="public" Grid.Column="3" Header="流控" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>XON/XOFF</x:String>
              <x:String>RTS</x:String>
              <x:String>RTS + XON/XOFF</x:String>
            </ComboBox>
            <ComboBox x:Name="EncodingComboBox" x:FieldModifier="public" Grid.Column="4" Header="编码" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>UTF-8</x:String>
              <x:String>ASCII</x:String>
              <x:String>GB2312</x:String>
              <x:String>GBK</x:String>
              <x:String>UTF-16 LE</x:String>
            </ComboBox>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom">
              <CheckBox x:Name="DtrCheckBox" x:FieldModifier="public" Content="DTR" />
              <CheckBox x:Name="RtsCheckBox" x:FieldModifier="public" Content="RTS" />
            </StackPanel>
          </Grid>
        </Expander>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" MinHeight="260" Style="{StaticResource SurfaceCardStyle}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
          <SelectorBarItem x:Name="MonitorSelectorItem" Text="报文" Icon="View" />
          <SelectorBarItem Text="波形" Icon="MapDrive" />
        </SelectorBar>
        <Grid x:Name="MonitorView" Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Padding="20,0">
            <TextBlock x:Name="CountersText" Text="RX 0 · TX 0" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <ToggleButton x:Name="TimestampToggle" x:FieldModifier="public" Content="时间戳" IsChecked="True" MinHeight="32" CornerRadius="4" />
              <Button x:Name="PauseButton" x:FieldModifier="public" Content="暂停" Click="PauseButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
              <Button Content="清空" Click="ClearButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <ListView x:Name="TrafficListView" x:FieldModifier="public" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}" />
            <StackPanel x:Name="MonitorEmptyState" x:FieldModifier="public" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="等待串口数据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="连接设备后，收发报文会显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="PlotView" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Padding="20,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PlotMode" x:FieldModifier="public" Header="解析模式" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PlotMode_SelectionChanged">
              <x:String>CSV 文本行</x:String>
              <x:String>二进制帧</x:String>
            </ComboBox>
            <NumberBox x:Name="PlotFrameLength" x:FieldModifier="public" Grid.Column="1" Header="帧长(字节)" Value="8" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact" IsEnabled="False" />
            <ComboBox x:Name="PlotSampleType" x:FieldModifier="public" Grid.Column="2" Header="数据类型" SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
              <x:String>Int16 LE</x:String>
              <x:String>Int16 BE</x:String>
              <x:String>UInt16 LE</x:String>
              <x:String>Float32 LE</x:String>
            </ComboBox>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <ToggleButton x:Name="PlotRunning" x:FieldModifier="public" Content="绘制中" IsChecked="True" MinWidth="84" MinHeight="36" CornerRadius="4" FontWeight="SemiBold" />
              <Button Content="清空" Click="PlotClearButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
          </Grid>
          <sp:WinUIPlot x:Name="WavePlot" x:FieldModifier="public" Grid.Row="1" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}">
      <StackPanel Spacing="14">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="发送" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
          <ComboBox x:Name="SendHistory" x:FieldModifier="public" Grid.Column="1" PlaceholderText="发送历史" HorizontalAlignment="Stretch" SelectionChanged="SendHistory_SelectionChanged" />
        </Grid>
        <TextBox x:Name="SendEditor" x:FieldModifier="public" AcceptsReturn="False" PlaceholderText="输入文本或 HEX" FontFamily="{StaticResource MonospaceFontFamily}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="SendFormat" x:FieldModifier="public" Header="格式" SelectedIndex="0" HorizontalAlignment="Stretch">
            <x:String>文本</x:String>
            <x:String>HEX</x:String>
          </ComboBox>
          <ComboBox x:Name="SendLineEnding" x:FieldModifier="public" Grid.Column="1" Header="行尾" SelectedIndex="0" HorizontalAlignment="Stretch">
            <x:String>无</x:String>
            <x:String>CR</x:String>
            <x:String>LF</x:String>
            <x:String>CRLF</x:String>
          </ComboBox>
          <ComboBox x:Name="SendChecksum" x:FieldModifier="public" Grid.Column="2" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
            <x:String>无</x:String>
            <x:String>XOR</x:String>
            <x:String>SUM8</x:String>
            <x:String>CRC16-Modbus</x:String>
            <x:String>CRC16-XModem</x:String>
            <x:String>CRC32</x:String>
          </ComboBox>
          <ToggleButton x:Name="LoopSendToggle" x:FieldModifier="public" Grid.Column="3" Content="循环发送" MinHeight="32" CornerRadius="4" VerticalAlignment="Bottom" Checked="LoopSendToggle_Checked" Unchecked="LoopSendToggle_Unchecked" />
          <NumberBox x:Name="LoopIntervalNumberBox" x:FieldModifier="public" Grid.Column="4" Header="间隔(ms)" Value="1000" Minimum="10" Maximum="600000" SpinButtonPlacementMode="Compact" Width="150" />
          <Button x:Name="SendButton" x:FieldModifier="public" Grid.Column="6" Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
        </Grid>
        <InfoBar x:Name="SendStatus" x:FieldModifier="public" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
