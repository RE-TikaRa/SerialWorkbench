<Page
    x:Class="SerialWorkbench.WinUI.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sp="using:ScottPlot.WinUI"
    NavigationCacheMode="Required"
    SizeChanged="WorkbenchPage_SizeChanged">
  <Page.Resources>
    <Storyboard x:Name="MonitorViewTransition">
      <FadeInThemeAnimation TargetName="MonitorView" />
    </Storyboard>
    <Storyboard x:Name="PlotViewTransition">
      <FadeInThemeAnimation TargetName="PlotView" />
    </Storyboard>
  </Page.Resources>
  <ScrollView x:Name="WorkbenchScroller" ContentOrientation="Vertical" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch">
    <Grid x:Name="WorkbenchLayout" MinHeight="{x:Bind WorkbenchScroller.ActualHeight, Mode=OneWay}" Padding="{StaticResource ContentPagePadding}" RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WindowStates">
          <VisualState x:Name="Compact">
            <VisualState.Setters>
              <Setter Target="BaudRateComboBox.(Grid.Column)" Value="0" />
              <Setter Target="BaudRateComboBox.(Grid.ColumnSpan)" Value="5" />
              <Setter Target="MonitorFormat.(Grid.Row)" Value="2" />
              <Setter Target="MonitorFormat.(Grid.Column)" Value="0" />
              <Setter Target="MonitorFormat.(Grid.ColumnSpan)" Value="5" />
              <Setter Target="ConnectButton.(Grid.Row)" Value="3" />
              <Setter Target="ConnectButton.(Grid.Column)" Value="0" />
              <Setter Target="ConnectButton.(Grid.ColumnSpan)" Value="5" />
              <Setter Target="ConnectButton.HorizontalAlignment" Value="Stretch" />
              <Setter Target="DataBitsNumberBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="ParityComboBox.(Grid.Row)" Value="1" />
              <Setter Target="ParityComboBox.(Grid.Column)" Value="0" />
              <Setter Target="ParityComboBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="StopBitsComboBox.(Grid.Row)" Value="2" />
              <Setter Target="StopBitsComboBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="HandshakeComboBox.(Grid.Row)" Value="3" />
              <Setter Target="HandshakeComboBox.(Grid.Column)" Value="0" />
              <Setter Target="HandshakeComboBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="EncodingComboBox.(Grid.Row)" Value="4" />
              <Setter Target="EncodingComboBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="ControlLinesPanel.(Grid.Row)" Value="5" />
              <Setter Target="ControlLinesPanel.(Grid.Column)" Value="0" />
              <Setter Target="ControlLinesPanel.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="ClearTrafficButton.(Grid.Row)" Value="1" />
              <Setter Target="ClearTrafficButton.(Grid.Column)" Value="0" />
              <Setter Target="ClearTrafficButton.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="ClearTrafficButton.HorizontalAlignment" Value="Stretch" />
              <Setter Target="CopyHexButton.(Grid.Row)" Value="1" />
              <Setter Target="CopyHexButton.(Grid.Column)" Value="2" />
              <Setter Target="CopyHexButton.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="CopyHexButton.HorizontalAlignment" Value="Stretch" />
              <Setter Target="PlotMode.(Grid.ColumnSpan)" Value="4" />
              <Setter Target="PlotFrameLength.(Grid.Row)" Value="1" />
              <Setter Target="PlotFrameLength.(Grid.Column)" Value="0" />
              <Setter Target="PlotFrameLength.(Grid.ColumnSpan)" Value="4" />
              <Setter Target="PlotSampleType.(Grid.Row)" Value="2" />
              <Setter Target="PlotSampleType.(Grid.ColumnSpan)" Value="4" />
              <Setter Target="PlotActions.(Grid.Row)" Value="3" />
              <Setter Target="PlotActions.(Grid.Column)" Value="0" />
              <Setter Target="PlotActions.(Grid.ColumnSpan)" Value="4" />
              <Setter Target="PlotActions.HorizontalAlignment" Value="Left" />
              <Setter Target="SendFormat.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="SendLineEnding.(Grid.Row)" Value="1" />
              <Setter Target="SendLineEnding.(Grid.Column)" Value="0" />
              <Setter Target="SendLineEnding.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="SendChecksum.(Grid.Row)" Value="2" />
              <Setter Target="SendChecksum.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="LoopIntervalNumberBox.(Grid.Row)" Value="3" />
              <Setter Target="LoopIntervalNumberBox.(Grid.Column)" Value="0" />
              <Setter Target="LoopIntervalNumberBox.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="LoopSendToggle.(Grid.Row)" Value="4" />
              <Setter Target="SendButton.(Grid.Row)" Value="4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Narrow" />
          <VisualState x:Name="Wide">
            <VisualState.Setters>
              <Setter Target="PortComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="RefreshPortsButton.(Grid.Column)" Value="1" />
              <Setter Target="BaudRateComboBox.(Grid.Row)" Value="0" />
              <Setter Target="BaudRateComboBox.(Grid.Column)" Value="2" />
              <Setter Target="BaudRateComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="MonitorFormat.(Grid.Row)" Value="0" />
              <Setter Target="MonitorFormat.(Grid.Column)" Value="3" />
              <Setter Target="MonitorFormat.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="ConnectButton.(Grid.Row)" Value="0" />
              <Setter Target="DataBitsNumberBox.(Grid.Row)" Value="0" />
              <Setter Target="DataBitsNumberBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="ParityComboBox.(Grid.Row)" Value="0" />
              <Setter Target="ParityComboBox.(Grid.Column)" Value="1" />
              <Setter Target="ParityComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="StopBitsComboBox.(Grid.Row)" Value="0" />
              <Setter Target="StopBitsComboBox.(Grid.Column)" Value="2" />
              <Setter Target="StopBitsComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="HandshakeComboBox.(Grid.Row)" Value="0" />
              <Setter Target="HandshakeComboBox.(Grid.Column)" Value="3" />
              <Setter Target="HandshakeComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="EncodingComboBox.(Grid.Row)" Value="0" />
              <Setter Target="EncodingComboBox.(Grid.Column)" Value="4" />
              <Setter Target="EncodingComboBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="ControlLinesPanel.(Grid.Row)" Value="0" />
              <Setter Target="ControlLinesPanel.(Grid.Column)" Value="5" />
              <Setter Target="ControlLinesPanel.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="MonitorActions.(Grid.Row)" Value="0" />
              <Setter Target="MonitorActions.HorizontalAlignment" Value="Right" />
              <Setter Target="PlotMode.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PlotFrameLength.(Grid.Column)" Value="1" />
              <Setter Target="PlotFrameLength.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PlotSampleType.(Grid.Row)" Value="0" />
              <Setter Target="PlotSampleType.(Grid.Column)" Value="2" />
              <Setter Target="PlotSampleType.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="PlotActions.(Grid.Row)" Value="0" />
              <Setter Target="PlotActions.(Grid.Column)" Value="3" />
              <Setter Target="PlotActions.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="SendHistory.(Grid.Row)" Value="0" />
              <Setter Target="SendHistory.(Grid.Column)" Value="1" />
              <Setter Target="SendHistory.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="SendFormat.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="SendLineEnding.(Grid.Column)" Value="1" />
              <Setter Target="SendLineEnding.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="SendChecksum.(Grid.Row)" Value="0" />
              <Setter Target="SendChecksum.(Grid.Column)" Value="2" />
              <Setter Target="SendChecksum.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="LoopSendToggle.(Grid.Row)" Value="0" />
              <Setter Target="LoopSendToggle.(Grid.Column)" Value="3" />
              <Setter Target="LoopSendToggle.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="LoopIntervalNumberBox.(Grid.Row)" Value="0" />
              <Setter Target="LoopIntervalNumberBox.(Grid.Column)" Value="4" />
              <Setter Target="LoopIntervalNumberBox.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="SendButton.(Grid.Row)" Value="0" />
              <Setter Target="SendButton.(Grid.Column)" Value="5" />
              <Setter Target="SendButton.(Grid.ColumnSpan)" Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="PageMarginStates">
          <VisualState x:Name="CompactPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="WorkbenchLayout.Padding" Value="{StaticResource CompactContentPagePadding}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="StandardPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="641" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="工作台" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="连接串口、收发报文并查看实时波形。" Style="{StaticResource PageDescriptionStyle}" />
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="{StaticResource CardContentSpacing}">
          <TextBlock Text="串口连接" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PortComboBox" x:FieldModifier="public" Grid.ColumnSpan="4" Header="端口" DisplayMemberPath="DisplayName" PlaceholderText="选择串口" HorizontalAlignment="Stretch" />
            <Button x:Name="RefreshPortsButton" x:FieldModifier="public" Grid.Column="4" Click="RefreshPortsButton_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Bottom" ToolTipService.ToolTip="刷新端口">
              <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
            <ComboBox x:Name="BaudRateComboBox" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" Header="波特率" IsEditable="True" SelectedIndex="7" HorizontalAlignment="Stretch">
              <x:String>1200</x:String>
              <x:String>2400</x:String>
              <x:String>4800</x:String>
              <x:String>9600</x:String>
              <x:String>19200</x:String>
              <x:String>38400</x:String>
              <x:String>57600</x:String>
              <x:String>115200</x:String>
              <x:String>230400</x:String>
              <x:String>460800</x:String>
              <x:String>921600</x:String>
            </ComboBox>
            <ComboBox x:Name="MonitorFormat" x:FieldModifier="public" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="显示" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>HEX</x:String>
              <x:String>文本</x:String>
            </ComboBox>
            <Button x:Name="ConnectButton" x:FieldModifier="public" Grid.Row="1" Grid.Column="4" Content="连接" Click="ConnectButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
          </Grid>
          <TextBlock x:Name="ConnectionStatusText" Text="正在连接服务…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Expander x:Name="AdvancedExpander" x:FieldModifier="public" Header="高级参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="12" RowSpacing="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <NumberBox x:Name="DataBitsNumberBox" x:FieldModifier="public" Grid.ColumnSpan="3" Header="数据位" Value="8" Minimum="5" Maximum="8" SpinButtonPlacementMode="Compact" />
              <ComboBox x:Name="ParityComboBox" x:FieldModifier="public" Grid.Column="3" Grid.ColumnSpan="3" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
                <x:String>无</x:String>
                <x:String>奇校验</x:String>
                <x:String>偶校验</x:String>
                <x:String>标记</x:String>
                <x:String>空格</x:String>
              </ComboBox>
              <ComboBox x:Name="StopBitsComboBox" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="3" Header="停止位" SelectedIndex="0" HorizontalAlignment="Stretch">
                <x:String>1</x:String>
                <x:String>1.5</x:String>
                <x:String>2</x:String>
              </ComboBox>
              <ComboBox x:Name="HandshakeComboBox" x:FieldModifier="public" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Header="流控" SelectedIndex="0" HorizontalAlignment="Stretch">
                <x:String>无</x:String>
                <x:String>XON/XOFF</x:String>
                <x:String>RTS</x:String>
                <x:String>RTS + XON/XOFF</x:String>
              </ComboBox>
              <ComboBox x:Name="EncodingComboBox" x:FieldModifier="public" Grid.Row="2" Grid.ColumnSpan="3" Header="编码" SelectedIndex="0" HorizontalAlignment="Stretch">
                <x:String>UTF-8</x:String>
                <x:String>ASCII</x:String>
                <x:String>GB2312</x:String>
                <x:String>GBK</x:String>
                <x:String>UTF-16 LE</x:String>
              </ComboBox>
              <StackPanel x:Name="ControlLinesPanel" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom">
                <CheckBox x:Name="DtrCheckBox" x:FieldModifier="public" Content="DTR" />
                <CheckBox x:Name="RtsCheckBox" x:FieldModifier="public" Content="RTS" />
              </StackPanel>
            </Grid>
          </Expander>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" MinHeight="260" Style="{StaticResource SurfaceCardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
            <SelectorBarItem x:Name="MonitorSelectorItem" Text="报文" Icon="Message" />
            <SelectorBarItem Text="波形">
              <SelectorBarItem.Icon>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEF3D;" />
              </SelectorBarItem.Icon>
            </SelectorBarItem>
          </SelectorBar>
          <Grid x:Name="MonitorView" Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="MonitorToolbar" Padding="20,10" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="CountersText" Text="RX 0 · TX 0" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
              <Grid x:Name="MonitorActions" Grid.Row="1" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="TimestampToggle" x:FieldModifier="public" Content="时间戳" IsChecked="True" />
                <Button x:Name="PauseButton" x:FieldModifier="public" Grid.Column="1" Content="暂停" Click="PauseButton_Click" />
                <Button x:Name="ClearTrafficButton" Grid.Column="2" Content="清空" Click="ClearButton_Click" />
                <Button x:Name="CopyHexButton" x:FieldModifier="public" Grid.Column="3" Click="CopyHexButton_Click" Style="{StaticResource IconButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="复制全部 HEX">
                  <SymbolIcon Symbol="Copy" />
                </Button>
              </Grid>
            </Grid>
            <Grid Grid.Row="1">
              <ListView x:Name="TrafficListView" x:FieldModifier="public" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}" />
              <StackPanel x:Name="MonitorEmptyState" x:FieldModifier="public" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="等待串口数据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="连接设备后，收发报文会显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Grid>
          <Grid x:Name="PlotView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="PlotToolbar" Padding="20,10" ColumnSpacing="12" RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="PlotMode" x:FieldModifier="public" Grid.ColumnSpan="2" Header="解析模式" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PlotMode_SelectionChanged">
                <x:String>CSV 文本行</x:String>
                <x:String>二进制帧</x:String>
              </ComboBox>
              <NumberBox x:Name="PlotFrameLength" x:FieldModifier="public" Grid.Column="2" Grid.ColumnSpan="2" Header="帧长(字节)" Value="8" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact" IsEnabled="False" />
              <ComboBox x:Name="PlotSampleType" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" Header="数据类型" SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                <x:String>Int16 LE</x:String>
                <x:String>Int16 BE</x:String>
                <x:String>UInt16 LE</x:String>
                <x:String>Float32 LE</x:String>
              </ComboBox>
              <StackPanel x:Name="PlotActions" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Bottom">
                <ToggleButton x:Name="PlotRunning" x:FieldModifier="public" Content="绘制中" IsChecked="True" />
                <Button Content="清空" Click="PlotClearButton_Click" />
              </StackPanel>
            </Grid>
            <sp:WinUIPlot x:Name="WavePlot" x:FieldModifier="public" Grid.Row="1" />
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="{StaticResource CardContentSpacing}">
          <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="发送" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="SendHistory" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" PlaceholderText="发送历史" HorizontalAlignment="Stretch" SelectionChanged="SendHistory_SelectionChanged" />
          </Grid>
          <TextBox x:Name="SendEditor" x:FieldModifier="public" AcceptsReturn="False" PlaceholderText="输入文本或 HEX" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SendFormat" x:FieldModifier="public" Grid.ColumnSpan="3" Header="格式" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>文本</x:String>
              <x:String>HEX</x:String>
            </ComboBox>
            <ComboBox x:Name="SendLineEnding" x:FieldModifier="public" Grid.Column="3" Grid.ColumnSpan="3" Header="行尾" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>CR</x:String>
              <x:String>LF</x:String>
              <x:String>CRLF</x:String>
            </ComboBox>
            <ComboBox x:Name="SendChecksum" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="3" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>XOR</x:String>
              <x:String>SUM8</x:String>
              <x:String>CRC16-Modbus</x:String>
              <x:String>CRC16-XModem</x:String>
              <x:String>CRC32</x:String>
            </ComboBox>
            <ToggleButton x:Name="LoopSendToggle" x:FieldModifier="public" Grid.Row="2" Grid.ColumnSpan="3" Content="循环发送" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Checked="LoopSendToggle_Checked" Unchecked="LoopSendToggle_Unchecked" />
            <NumberBox x:Name="LoopIntervalNumberBox" x:FieldModifier="public" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Header="间隔(ms)" Value="1000" Minimum="10" Maximum="600000" SpinButtonPlacementMode="Compact" />
            <Button x:Name="SendButton" x:FieldModifier="public" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Content="发送" Click="SendButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
          </Grid>
          <InfoBar x:Name="SendStatus" x:FieldModifier="public" IsOpen="False" IsClosable="True" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollView>
</Page>
