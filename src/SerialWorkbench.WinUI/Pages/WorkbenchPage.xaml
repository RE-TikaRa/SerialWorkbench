<Page
    x:Class="SerialWorkbench.WinUI.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls">
  <Grid Padding="36,24,36,36" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" MaxWidth="1064" HorizontalAlignment="Left" Title="接收" Description="连接串口并查看实时收到的数据。" />

    <Border Grid.Row="1" MaxWidth="1064" HorizontalAlignment="Left" Style="{StaticResource SurfaceCardStyle}">
      <StackPanel Spacing="14">
        <TextBlock Text="串口连接" Style="{StaticResource SectionHeaderStyle}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="PortComboBox" x:FieldModifier="public" Header="端口" DisplayMemberPath="DisplayName" PlaceholderText="选择串口" />
          <NumberBox x:Name="BaudRateNumberBox" x:FieldModifier="public" Grid.Column="1" Header="波特率" Value="115200" Minimum="50" Maximum="12000000" SpinButtonPlacementMode="Hidden" />
          <ComboBox x:Name="MonitorFormat" x:FieldModifier="public" Grid.Column="2" Header="显示" SelectedIndex="0">
            <x:String>HEX</x:String>
            <x:String>文本</x:String>
          </ComboBox>
          <Button x:Name="ConnectButton" x:FieldModifier="public" Grid.Column="3" Content="连接" Click="ConnectButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" MaxWidth="1064" MinHeight="320" HorizontalAlignment="Left" Style="{StaticResource SurfaceCardStyle}" Padding="0">
      <TabView IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False">
        <TabViewItem Header="监视" IsClosable="False">
          <TabViewItem.IconSource>
            <SymbolIconSource Symbol="View" />
          </TabViewItem.IconSource>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="54" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="20,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="PauseButton" x:FieldModifier="public" Content="暂停" Click="PauseButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="清空" Click="ClearButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
              <ListView x:Name="TrafficListView" x:FieldModifier="public" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}" />
              <StackPanel x:Name="MonitorEmptyState" x:FieldModifier="public" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="等待串口数据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="连接设备后，收发报文会显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Grid>
        </TabViewItem>
        <TabViewItem Header="发送" IsClosable="False">
          <TabViewItem.IconSource>
            <SymbolIconSource Symbol="Send" />
          </TabViewItem.IconSource>
          <Grid Padding="20" RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SendEditor" x:FieldModifier="public" Grid.Row="0" Grid.ColumnSpan="4" AcceptsReturn="False" Header="发送数据" PlaceholderText="输入文本或 HEX" FontFamily="{StaticResource MonospaceFontFamily}" />
            <ComboBox x:Name="SendFormat" x:FieldModifier="public" Grid.Row="1" Grid.Column="1" Header="格式" SelectedIndex="0">
              <x:String>文本</x:String>
              <x:String>HEX</x:String>
            </ComboBox>
            <ComboBox x:Name="SendLineEnding" x:FieldModifier="public" Grid.Row="1" Grid.Column="2" Header="行尾" SelectedIndex="0">
              <x:String>无</x:String>
              <x:String>CR</x:String>
              <x:String>LF</x:String>
              <x:String>CRLF</x:String>
            </ComboBox>
            <Button x:Name="SendButton" x:FieldModifier="public" Grid.Row="1" Grid.Column="3" Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
            <InfoBar x:Name="SendStatus" x:FieldModifier="public" Grid.Row="1" Grid.Column="0" IsOpen="False" IsClosable="True" />
          </Grid>
        </TabViewItem>
      </TabView>
    </Border>
  </Grid>
</Page>
