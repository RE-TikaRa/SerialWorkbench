<Page
    x:Class="SerialWorkbench.WinUI.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls">
  <Grid Padding="40,32" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid MaxWidth="1100">
      <controls:PageHeader Title="接收" Description="连接串口并查看实时收到的数据。" />
    </Grid>
    <Border Grid.Row="1" MaxWidth="1100" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="串口连接" FontSize="17" FontWeight="SemiBold" />
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PortComboBox" x:FieldModifier="public" Header="端口" DisplayMemberPath="DisplayName" PlaceholderText="选择串口"/><NumberBox x:Name="BaudRateNumberBox" x:FieldModifier="public" Grid.Column="1" Header="波特率" Value="115200" Minimum="50" Maximum="12000000" SpinButtonPlacementMode="Hidden"/><ComboBox x:Name="MonitorFormat" x:FieldModifier="public" Grid.Column="2" Header="显示" SelectedIndex="0"><x:String>HEX</x:String><x:String>文本</x:String></ComboBox><Button x:Name="ConnectButton" x:FieldModifier="public" Grid.Column="3" Content="连接" Click="ConnectButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/></Grid>
        </StackPanel>
      </Border>
    <Border Grid.Row="2" MaxWidth="1100" MinHeight="260" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
      <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="20,0"><TextBlock Text="实时监视" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="PauseButton" x:FieldModifier="public" Content="暂停" Click="PauseButton_Click" Style="{StaticResource ToolbarButtonStyle}"/><Button Content="清空" Click="ClearButton_Click" Style="{StaticResource ToolbarButtonStyle}"/></StackPanel></Grid><Grid Grid.Row="1"><ListView x:Name="TrafficListView" x:FieldModifier="public" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}"/><StackPanel x:Name="MonitorEmptyState" x:FieldModifier="public" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"><TextBlock Text="等待串口数据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="连接设备后，收发报文会显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></Grid>
    </Border>
    <Border Grid.Row="3" MaxWidth="1100" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
      <Grid RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="SendEditor" x:FieldModifier="public" Grid.Row="0" Grid.ColumnSpan="4" AcceptsReturn="False" Header="发送数据" PlaceholderText="输入文本或 HEX" FontFamily="Consolas"/><ComboBox x:Name="SendFormat" x:FieldModifier="public" Grid.Row="1" Grid.Column="1" Header="格式" SelectedIndex="0"><x:String>文本</x:String><x:String>HEX</x:String></ComboBox><ComboBox x:Name="SendLineEnding" x:FieldModifier="public" Grid.Row="1" Grid.Column="2" Header="行尾" SelectedIndex="0"><x:String>无</x:String><x:String>CR</x:String><x:String>LF</x:String><x:String>CRLF</x:String></ComboBox><Button x:Name="SendButton" x:FieldModifier="public" Grid.Row="1" Grid.Column="3" Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/><InfoBar x:Name="SendStatus" x:FieldModifier="public" Grid.Row="1" Grid.Column="0" IsOpen="False" IsClosable="True" /> </Grid>
    </Border>
  </Grid>
</Page>
