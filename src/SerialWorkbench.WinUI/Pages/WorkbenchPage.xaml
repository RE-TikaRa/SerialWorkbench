<Page
    x:Class="SerialWorkbench.WinUI.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sp="using:ScottPlot.WinUI"
    NavigationCacheMode="Required"
    SizeChanged="WorkbenchPage_SizeChanged">
  <Page.Resources>
    <Storyboard x:Name="MonitorViewTransition">
      <FadeInThemeAnimation TargetName="MonitorView" />
    </Storyboard>
    <Storyboard x:Name="PlotViewTransition">
      <FadeInThemeAnimation TargetName="PlotView" />
    </Storyboard>
  </Page.Resources>
  <Grid x:Name="WorkbenchScroller">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowStates">
        <VisualState x:Name="Compact">
          <VisualState.Setters>
            <Setter Target="SendFormat.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="SendLineEnding.(Grid.Column)" Value="3" />
            <Setter Target="SendLineEnding.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="SendChecksum.(Grid.Row)" Value="1" />
            <Setter Target="SendChecksum.(Grid.Column)" Value="0" />
            <Setter Target="SendChecksum.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="SendChecksum.Margin" Value="0,12,0,0" />
            <Setter Target="LoopIntervalNumberBox.(Grid.Column)" Value="3" />
            <Setter Target="LoopIntervalNumberBox.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="LoopSendToggle.(Grid.Row)" Value="2" />
            <Setter Target="LoopSendToggle.(Grid.Column)" Value="0" />
            <Setter Target="LoopSendToggle.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="SendButton.(Grid.Row)" Value="2" />
            <Setter Target="SendButton.(Grid.Column)" Value="3" />
            <Setter Target="SendButton.(Grid.ColumnSpan)" Value="3" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Narrow" />
        <VisualState x:Name="Wide">
          <VisualState.Setters>
            <Setter Target="PortComboBox.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="RefreshPortsButton.(Grid.Column)" Value="1" />
            <Setter Target="BaudRateComboBox.(Grid.Row)" Value="0" />
            <Setter Target="BaudRateComboBox.(Grid.Column)" Value="2" />
            <Setter Target="BaudRateComboBox.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="BaudRateComboBox.Margin" Value="0" />
            <Setter Target="MonitorFormat.(Grid.Row)" Value="0" />
            <Setter Target="MonitorFormat.Margin" Value="0" />
            <Setter Target="BaudRateComboBox.Width" Value="132" />
            <Setter Target="AdvancedButton.(Grid.Row)" Value="0" />
            <Setter Target="AdvancedButton.Margin" Value="0" />
            <Setter Target="ConnectButton.(Grid.Row)" Value="0" />
            <Setter Target="ConnectButton.Margin" Value="0" />
            <Setter Target="MonitorActions.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="TrafficFilters.(Grid.Row)" Value="0" />
            <Setter Target="TrafficFilters.(Grid.Column)" Value="2" />
            <Setter Target="TrafficFilters.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="TrafficFilters.Margin" Value="0" />
            <Setter Target="PlotMode.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="PlotFrameLength.(Grid.Column)" Value="1" />
            <Setter Target="PlotFrameLength.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="PlotSampleType.(Grid.Row)" Value="0" />
            <Setter Target="PlotSampleType.(Grid.Column)" Value="2" />
            <Setter Target="PlotSampleType.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="PlotSampleType.Margin" Value="0" />
            <Setter Target="PlotActions.(Grid.Row)" Value="0" />
            <Setter Target="PlotActions.(Grid.Column)" Value="3" />
            <Setter Target="PlotActions.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="PlotActions.Margin" Value="0" />
            <Setter Target="SendFormat.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="SendLineEnding.(Grid.Column)" Value="1" />
            <Setter Target="SendLineEnding.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="SendChecksum.(Grid.Row)" Value="0" />
            <Setter Target="SendChecksum.(Grid.Column)" Value="2" />
            <Setter Target="SendChecksum.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="LoopSendToggle.(Grid.Row)" Value="0" />
            <Setter Target="LoopSendToggle.(Grid.Column)" Value="3" />
            <Setter Target="LoopSendToggle.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="LoopSendToggle.Margin" Value="0" />
            <Setter Target="LoopIntervalNumberBox.(Grid.Row)" Value="0" />
            <Setter Target="LoopIntervalNumberBox.(Grid.Column)" Value="4" />
            <Setter Target="LoopIntervalNumberBox.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="LoopIntervalNumberBox.Margin" Value="0" />
            <Setter Target="SendButton.(Grid.Row)" Value="0" />
            <Setter Target="SendButton.(Grid.Column)" Value="5" />
            <Setter Target="SendButton.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="SendButton.Margin" Value="0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="PageMarginStates">
        <VisualState x:Name="CompactPageMargins">
          <VisualState.Setters>
            <Setter Target="WorkbenchLayout.Padding" Value="{StaticResource CompactContentPagePadding}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardPageMargins" />
      </VisualStateGroup>
      <VisualStateGroup x:Name="HeightStates">
        <VisualState x:Name="CompactHeight">
          <VisualState.Setters>
            <Setter Target="WorkbenchLayout.RowSpacing" Value="8" />
            <Setter Target="ConnectionCard.Padding" Value="8" />
            <Setter Target="SendCard.Padding" Value="8" />
            <Setter Target="SendContent.Spacing" Value="8" />
            <Setter Target="MonitorToolbar.Padding" Value="12,8" />
            <Setter Target="PlotToolbar.Padding" Value="12,8" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardHeight" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid x:Name="WorkbenchLayout" Padding="{StaticResource ContentPagePadding}" RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="ConnectionCard" Style="{StaticResource SurfaceCardStyle}">
        <Grid ColumnSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="PortComboBox" Grid.ColumnSpan="5" Header="端口" DisplayMemberPath="DisplayName" PlaceholderText="选择串口" HorizontalAlignment="Stretch" />
          <Button x:Name="RefreshPortsButton" Grid.Column="5" Click="RefreshPortsButton_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Bottom" ToolTipService.ToolTip="刷新端口" AutomationProperties.Name="刷新端口">
            <FontIcon Glyph="&#xE72C;" FontSize="16" />
          </Button>
          <ComboBox x:Name="BaudRateComboBox" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Header="波特率" IsEditable="True" SelectedIndex="7" HorizontalAlignment="Stretch" SelectionChanged="BaudRateComboBox_SelectionChanged" TextSubmitted="BaudRateComboBox_TextSubmitted">
            <x:String>1200</x:String>
            <x:String>2400</x:String>
            <x:String>4800</x:String>
            <x:String>9600</x:String>
            <x:String>19200</x:String>
            <x:String>38400</x:String>
            <x:String>57600</x:String>
            <x:String>115200</x:String>
            <x:String>230400</x:String>
            <x:String>460800</x:String>
            <x:String>921600</x:String>
          </ComboBox>
          <ComboBox x:Name="MonitorFormat" Grid.Row="1" Grid.Column="3" Margin="0,12,0,0" Width="96" Header="显示" SelectedIndex="0" SelectionChanged="MonitorFormat_SelectionChanged">
            <x:String>HEX</x:String>
            <x:String>文本</x:String>
          </ComboBox>
          <Button x:Name="AdvancedButton" Grid.Row="1" Grid.Column="4" Margin="0,12,0,0" Content="高级参数" Click="AdvancedButton_Click" VerticalAlignment="Bottom" />
          <Button x:Name="ConnectButton" Grid.Row="1" Grid.Column="5" Margin="0,12,0,0" Content="连接" Click="ConnectButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
          <TextBlock x:Name="ConnectionStatusText" Grid.Row="2" Grid.ColumnSpan="6" Margin="0,8,0,0" Text="正在连接服务…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
      </Border>
      <Border x:Name="TrafficCard" Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
            <SelectorBarItem x:Name="MonitorSelectorItem" Text="报文" Icon="Message" />
            <SelectorBarItem Text="波形">
              <SelectorBarItem.Icon>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEF3D;" />
              </SelectorBarItem.Icon>
            </SelectorBarItem>
          </SelectorBar>
          <Grid x:Name="MonitorView" Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="MonitorToolbar" Padding="20,10" ColumnSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="CountersText" Text="RX 0 · TX 0" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
              <Grid x:Name="MonitorActions" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="TimestampToggle" x:FieldModifier="public" Content="时间戳" IsChecked="True" Click="TimestampToggle_Click" />
                <Button x:Name="PauseButton" x:FieldModifier="public" Grid.Column="1" Content="暂停" Click="PauseButton_Click" />
                <Button x:Name="ClearTrafficButton" Grid.Column="2" Content="清空" Click="ClearButton_Click" />
                <Button x:Name="CopyHexButton" x:FieldModifier="public" Grid.Column="3" Click="CopyHexButton_Click" Style="{StaticResource IconButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="复制当前列表 HEX" AutomationProperties.Name="复制当前列表 HEX">
                  <SymbolIcon Symbol="Copy" />
                </Button>
              </Grid>
              <Grid x:Name="TrafficFilters" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TrafficDirection" SelectionChanged="TrafficFilter_Changed">
                  <x:String>全部方向</x:String>
                  <x:String>仅 RX</x:String>
                  <x:String>仅 TX</x:String>
                </ComboBox>
                <TextBox x:Name="TrafficSearch" Grid.Column="1" PlaceholderText="搜索文本、HEX 或来源" TextChanged="TrafficSearch_TextChanged" />
              </Grid>
            </Grid>
            <Grid Grid.Row="1">
              <ListView x:Name="TrafficListView" SelectionMode="Extended" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <StackPanel x:Name="MonitorEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="MonitorEmptyTitle" Text="等待串口数据" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="MonitorEmptyDescription" Text="连接设备后，收发报文会显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
          <Grid x:Name="PlotView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="PlotToolbar" Padding="20,10" ColumnSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="PlotMode" x:FieldModifier="public" Grid.ColumnSpan="2" Header="解析模式" HorizontalAlignment="Stretch" SelectionChanged="PlotMode_SelectionChanged">
                <x:String>CSV 文本行</x:String>
                <x:String>二进制帧</x:String>
              </ComboBox>
              <NumberBox x:Name="PlotFrameLength" x:FieldModifier="public" Grid.Column="2" Grid.ColumnSpan="2" Header="帧长(字节)" Value="8" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact" IsEnabled="False" />
              <ComboBox x:Name="PlotSampleType" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Header="数据类型" SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                <x:String>Int16 LE</x:String>
                <x:String>Int16 BE</x:String>
                <x:String>UInt16 LE</x:String>
                <x:String>Float32 LE</x:String>
              </ComboBox>
              <StackPanel x:Name="PlotActions" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Bottom">
                <ToggleButton x:Name="PlotRunning" x:FieldModifier="public" Content="实时绘制" IsChecked="True" />
                <Button Content="清空" Click="PlotClearButton_Click" />
              </StackPanel>
            </Grid>
            <sp:WinUIPlot x:Name="WavePlot" x:FieldModifier="public" Grid.Row="1" />
          </Grid>
        </Grid>
      </Border>
      <Border x:Name="SendCard" Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
        <StackPanel x:Name="SendContent" Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="发送" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <TextBox x:Name="SendEditor" x:FieldModifier="public" Grid.Column="1" AcceptsReturn="False" TextWrapping="NoWrap" VerticalAlignment="Top" PlaceholderText="输入文本或 HEX" FontFamily="{StaticResource MonospaceFontFamily}" PreviewKeyDown="SendEditor_PreviewKeyDown" />
            <ComboBox x:Name="SendHistory" x:FieldModifier="public" Grid.Column="2" PlaceholderText="发送历史" HorizontalAlignment="Stretch" SelectionChanged="SendHistory_SelectionChanged" />
          </Grid>
          <Grid ColumnSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SendFormat" x:FieldModifier="public" Grid.ColumnSpan="2" Header="格式" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>文本</x:String>
              <x:String>HEX</x:String>
            </ComboBox>
            <ComboBox x:Name="SendLineEnding" x:FieldModifier="public" Grid.Column="2" Grid.ColumnSpan="2" Header="行尾" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>CR</x:String>
              <x:String>LF</x:String>
              <x:String>CRLF</x:String>
            </ComboBox>
            <ComboBox x:Name="SendChecksum" x:FieldModifier="public" Grid.Column="4" Grid.ColumnSpan="2" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>XOR</x:String>
              <x:String>SUM8</x:String>
              <x:String>CRC16-Modbus</x:String>
              <x:String>CRC16-XModem</x:String>
              <x:String>CRC32</x:String>
            </ComboBox>
            <ToggleButton x:Name="LoopSendToggle" x:FieldModifier="public" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Content="循环发送" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Checked="LoopSendToggle_Checked" Unchecked="LoopSendToggle_Unchecked" />
            <NumberBox x:Name="LoopIntervalNumberBox" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Header="间隔(ms)" Value="1000" Minimum="10" Maximum="600000" SpinButtonPlacementMode="Compact" />
            <Button x:Name="SendButton" x:FieldModifier="public" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,12,0,0" Content="发送" Click="SendButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" ToolTipService.ToolTip="发送 (Ctrl+Enter)" />
          </Grid>
          <InfoBar x:Name="SendStatus" x:FieldModifier="public" IsOpen="False" IsClosable="True" Visibility="{x:Bind SendStatus.IsOpen, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </Grid>
    <ContentDialog x:Name="AdvancedDialog" Title="高级参数" CloseButtonText="完成" Style="{StaticResource DefaultContentDialogStyle}">
      <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
      </ContentDialog.Resources>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="520" Spacing="{StaticResource CardContentSpacing}">
          <Grid ColumnSpacing="8">
            <FlyoutBase.AttachedFlyout>
              <Flyout x:Name="ProfileNameFlyout">
                <StackPanel Width="280" Spacing="8">
                  <TextBox x:Name="ProfileNameBox" Header="配置名称" PlaceholderText="输入配置名称" KeyDown="ProfileNameBox_KeyDown" />
                  <TextBlock x:Name="ProfileNameError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                  <Button Content="保存" Click="SaveProfileNameButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" />
                </StackPanel>
              </Flyout>
            </FlyoutBase.AttachedFlyout>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileComboBox" Header="连接配置" DisplayMemberPath="Name" PlaceholderText="选择配置" SelectionChanged="ProfileComboBox_SelectionChanged" HorizontalAlignment="Stretch" />
            <Button x:Name="ApplyProfileButton" Grid.Column="1" Content="应用" Click="ApplyProfileButton_Click" IsEnabled="False" VerticalAlignment="Bottom" />
            <Button x:Name="NewProfileButton" Grid.Column="2" Content="新建" Click="NewProfileButton_Click" VerticalAlignment="Bottom" />
            <Button x:Name="RenameProfileButton" Grid.Column="3" Content="重命名" Click="RenameProfileButton_Click" IsEnabled="False" VerticalAlignment="Bottom" />
            <Button x:Name="DeleteProfileButton" Grid.Column="4" Content="删除" IsEnabled="False" VerticalAlignment="Bottom">
              <Button.Flyout>
                <Flyout x:Name="DeleteProfileFlyout" Opening="DeleteProfileFlyout_Opening">
                  <StackPanel Width="280" Spacing="8">
                    <TextBlock x:Name="DeleteProfileText" TextWrapping="Wrap" />
                    <Button Content="删除" Click="ConfirmDeleteProfileButton_Click" HorizontalAlignment="Right" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <NumberBox x:Name="HexReceiveGapNumberBox" Header="HEX 接收分行间隔(ms)" Value="10" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Compact" ValueChanged="HexReceiveGapNumberBox_ValueChanged" />
          <TextBlock Text="间隔内的连续接收数据合并显示；0 表示按原始读取块分行。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="串口参数" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="DataBitsNumberBox" Header="数据位" Value="8" Minimum="5" Maximum="8" SpinButtonPlacementMode="Compact" />
            <ComboBox x:Name="ParityComboBox" Grid.Column="1" Header="校验" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>无</x:String>
              <x:String>奇校验</x:String>
              <x:String>偶校验</x:String>
              <x:String>标记</x:String>
              <x:String>空格</x:String>
            </ComboBox>
            <ComboBox x:Name="StopBitsComboBox" Grid.Column="2" Header="停止位" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>1</x:String>
              <x:String>1.5</x:String>
              <x:String>2</x:String>
            </ComboBox>
            <ComboBox x:Name="HandshakeComboBox" Grid.Row="1" Header="流控" HorizontalAlignment="Stretch" SelectionChanged="HandshakeComboBox_SelectionChanged">
              <x:String>无</x:String>
              <x:String>XON/XOFF</x:String>
              <x:String>RTS</x:String>
              <x:String>RTS + XON/XOFF</x:String>
            </ComboBox>
            <ComboBox x:Name="EncodingComboBox" Grid.Row="1" Grid.Column="1" Header="编码" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>UTF-8</x:String>
              <x:String>ASCII</x:String>
              <x:String>GBK</x:String>
              <x:String>UTF-16 LE</x:String>
            </ComboBox>
            <ComboBox x:Name="RoleComboBox" Grid.Row="1" Grid.Column="2" Header="逻辑角色" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>DUT</x:String>
              <x:String>DEBUG</x:String>
              <x:String>CONTROLLER</x:String>
              <x:String>LOOPBACK</x:String>
            </ComboBox>
          </Grid>
          <TextBlock Text="控制线" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="DtrToggle" Content="DTR" Click="ControlLineToggle_Click" />
            <ToggleButton x:Name="RtsToggle" Content="RTS" Click="ControlLineToggle_Click" />
            <Button x:Name="ClearReceiveButton" Content="清空 RX" Click="ClearReceiveButton_Click" IsEnabled="False" />
            <Button x:Name="ClearTransmitButton" Content="清空 TX" Click="ClearTransmitButton_Click" IsEnabled="False" />
            <Button x:Name="BreakButton" Content="BREAK" Click="BreakButton_Click" IsEnabled="False" />
          </StackPanel>
          <TextBlock Text="RS-485 半双工" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <CheckBox x:Name="Rs485ModeCheckBox" Content="启用 RTS 方向控制" Checked="Rs485ModeCheckBox_Changed" Unchecked="Rs485ModeCheckBox_Changed" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="RtsBeforeSendNumberBox" Header="发送前延时(ms)" Value="0" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="RtsAfterSendNumberBox" Grid.Column="1" Header="发送后延时(ms)" Value="0" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Compact" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Grid>
</Page>
