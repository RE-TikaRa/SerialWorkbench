<Page x:Class="SerialWorkbench.WinUI.Pages.LoopbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="LoopbackPage_SizeChanged">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="{StaticResource ContentPageSpacing}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WindowStates">
          <VisualState x:Name="Compact">
            <VisualState.Setters>
              <Setter Target="Length.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="Iterations.(Grid.Row)" Value="1" />
              <Setter Target="Iterations.(Grid.Column)" Value="0" />
              <Setter Target="Iterations.(Grid.ColumnSpan)" Value="6" />
              <Setter Target="Pattern.(Grid.Row)" Value="2" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Narrow" />
          <VisualState x:Name="Wide">
            <VisualState.Setters>
              <Setter Target="Length.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="Iterations.(Grid.Column)" Value="2" />
              <Setter Target="Iterations.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="Pattern.(Grid.Row)" Value="0" />
              <Setter Target="Pattern.(Grid.Column)" Value="4" />
              <Setter Target="Pattern.(Grid.ColumnSpan)" Value="2" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="PageMarginStates">
          <VisualState x:Name="CompactPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="StandardPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="641" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel Spacing="6">
        <TextBlock Text="回环检测" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="验证串口发送与接收链路是否正常。" Style="{StaticResource PageDescriptionStyle}" />
      </StackPanel>
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="{StaticResource CardContentSpacing}">
          <TextBlock Text="测试参数" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="Length" x:FieldModifier="public" Grid.ColumnSpan="3" Header="长度" Value="64" />
            <NumberBox x:Name="Iterations" x:FieldModifier="public" Grid.Column="3" Grid.ColumnSpan="3" Header="次数" Value="1" />
            <ComboBox x:Name="Pattern" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="6" Header="模式" SelectedIndex="0" HorizontalAlignment="Stretch">
              <x:String>递增</x:String>
              <x:String>固定</x:String>
              <x:String>随机</x:String>
            </ComboBox>
          </Grid>
          <Button x:Name="RunButton" x:FieldModifier="public" Content="运行检测" Click="RunButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <InfoBar x:Name="Result" x:FieldModifier="public" IsOpen="False" IsClosable="True" />
    </StackPanel>
  </ScrollView>
</Page>
