<Page x:Class="SerialWorkbench.WinUI.Pages.XmodemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="XmodemPage_SizeChanged">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ActionLayoutStates">
        <VisualState x:Name="StackedActions">
          <VisualState.Setters>
            <Setter Target="ActionButtons.(Grid.Column)" Value="0" />
            <Setter Target="Result.(Grid.Row)" Value="1" />
            <Setter Target="Result.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="Result.Margin" Value="0,12,0,0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="InlineActions" />
      </VisualStateGroup>
      <VisualStateGroup x:Name="PageMarginStates">
        <VisualState x:Name="CompactPageMargins">
          <VisualState.Setters>
            <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardPageMargins" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="XMODEM-CRC 文件传输" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="使用当前串口连接传输文件，传输过程与普通发送互斥。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <TextBox x:Name="FilePath" Header="文件" IsReadOnly="True" />
          <ProgressBar x:Name="TransferProgress" IsIndeterminate="True" Visibility="Collapsed" />
          <Grid ColumnSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="Result" IsOpen="False" IsClosable="True" Visibility="{x:Bind Result.IsOpen, Mode=OneWay}" />
            <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="SendButton" x:FieldModifier="public" Content="发送文件" Click="SendButton_Click" />
              <Button x:Name="ReceiveButton" x:FieldModifier="public" Content="接收文件" Click="ReceiveButton_Click" />
              <Button x:Name="CancelButton" x:FieldModifier="public" Content="停止" Click="CancelButton_Click" IsEnabled="False" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock x:Name="ProgressText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
  </ScrollView>
</Page>
