<Page x:Class="SerialWorkbench.WinUI.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="TerminalPage_SizeChanged">
  <Grid x:Name="PageLayout" Padding="{StaticResource ContentPagePadding}" RowSpacing="{StaticResource ContentPageSpacing}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowStates">
        <VisualState x:Name="Compact">
          <VisualState.Setters>
            <Setter Target="PageLayout.Padding" Value="{StaticResource CompactContentPagePadding}" />
            <Setter Target="HistoryComboBox.(Grid.Row)" Value="1" />
            <Setter Target="HistoryComboBox.(Grid.Column)" Value="0" />
            <Setter Target="HistoryComboBox.(Grid.ColumnSpan)" Value="6" />
            <Setter Target="HistoryComboBox.Margin" Value="0,12,0,0" />
            <Setter Target="InputFormat.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="LineEnding.(Grid.Column)" Value="3" />
            <Setter Target="LineEnding.(Grid.ColumnSpan)" Value="3" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource SurfaceCardStyle}">
      <Grid>
        <ListView x:Name="TerminalList" ItemsSource="{x:Bind Rows}" SelectionMode="None" ItemContainerStyle="{StaticResource TrafficListViewItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="10,5" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Time}" Visibility="{Binding TimeVisibility}" />
                <Border Grid.Column="1" Padding="7,2" HorizontalAlignment="Left" Background="{ThemeResource TrafficReceiveBackgroundBrush}" CornerRadius="4" Visibility="{Binding ReceiveVisibility}">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TrafficReceiveBrush}" Text="RX" />
                </Border>
                <Border Grid.Column="1" Padding="7,2" HorizontalAlignment="Left" Background="{ThemeResource TrafficTransmitBackgroundBrush}" CornerRadius="4" Visibility="{Binding TransmitVisibility}">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TrafficTransmitBrush}" Text="TX" />
                </Border>
                <TextBlock Grid.Column="2" FontFamily="{StaticResource MonospaceFontFamily}" Text="{Binding Display}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Display}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyState" Text="尚无终端报文" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
      <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="InputFormat" Grid.ColumnSpan="2" Header="输入格式" SelectedIndex="0" HorizontalAlignment="Stretch">
            <x:String>文本</x:String>
            <x:String>HEX</x:String>
          </ComboBox>
          <ComboBox x:Name="LineEnding" Grid.Column="2" Grid.ColumnSpan="2" Header="行尾" SelectedIndex="0" HorizontalAlignment="Stretch">
            <x:String>无</x:String>
            <x:String>CR</x:String>
            <x:String>LF</x:String>
            <x:String>CRLF</x:String>
          </ComboBox>
          <ComboBox x:Name="HistoryComboBox" Grid.Column="4" Grid.ColumnSpan="2" Header="历史" PlaceholderText="选择历史输入" SelectionChanged="HistoryComboBox_SelectionChanged" HorizontalAlignment="Stretch" />
        </Grid>
        <TextBox x:Name="InputEditor" AcceptsReturn="True" Header="输入" PlaceholderText="输入文本或 HEX 数据" TextWrapping="Wrap" MinHeight="88" PreviewKeyDown="InputEditor_PreviewKeyDown" />
        <InfoBar x:Name="SendStatus" IsOpen="False" IsClosable="True" Visibility="{x:Bind SendStatus.IsOpen, Mode=OneWay}" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ClearOutputButton" Content="清空终端" Click="ClearOutputButton_Click" HorizontalAlignment="Left" />
          <Button x:Name="ClearInputButton" Grid.Column="1" Content="清空输入" Click="ClearInputButton_Click" />
          <Button x:Name="CopyOutputButton" Grid.Column="2" Content="复制响应" Click="CopyOutputButton_Click" />
          <Button x:Name="SendButton" Grid.Column="3" Content="发送" Click="SendButton_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="发送 (Ctrl+Enter)" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Page>
