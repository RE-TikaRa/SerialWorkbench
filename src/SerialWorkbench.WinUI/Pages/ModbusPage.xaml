<Page
    x:Class="SerialWorkbench.WinUI.Pages.ModbusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="ModbusPage_SizeChanged">
  <ScrollView x:Name="PageScroller" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowStates">
        <VisualState x:Name="Compact">
          <VisualState.Setters>
            <Setter Target="SlaveAddress.(Grid.ColumnSpan)" Value="4" />
            <Setter Target="FunctionCode.(Grid.Row)" Value="1" />
            <Setter Target="FunctionCode.(Grid.Column)" Value="0" />
            <Setter Target="FunctionCode.(Grid.ColumnSpan)" Value="4" />
            <Setter Target="StartAddress.(Grid.Row)" Value="2" />
            <Setter Target="StartAddress.(Grid.ColumnSpan)" Value="4" />
            <Setter Target="Quantity.(Grid.Row)" Value="3" />
            <Setter Target="Quantity.(Grid.Column)" Value="0" />
            <Setter Target="Quantity.(Grid.ColumnSpan)" Value="4" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Narrow" />
        <VisualState x:Name="Wide">
          <VisualState.Setters>
            <Setter Target="SlaveAddress.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="FunctionCode.(Grid.Column)" Value="1" />
            <Setter Target="FunctionCode.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="StartAddress.(Grid.Row)" Value="0" />
            <Setter Target="StartAddress.(Grid.Column)" Value="2" />
            <Setter Target="StartAddress.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="Quantity.(Grid.Row)" Value="0" />
            <Setter Target="Quantity.(Grid.Column)" Value="3" />
            <Setter Target="Quantity.(Grid.ColumnSpan)" Value="1" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="CardLayoutStates">
        <VisualState x:Name="StackedCards" />
        <VisualState x:Name="SplitCards">
          <VisualState.Setters>
            <Setter Target="RequestCard.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="ResponseCard.(Grid.Row)" Value="0" />
            <Setter Target="ResponseCard.(Grid.Column)" Value="1" />
            <Setter Target="ResponseCard.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="Result.(Grid.Row)" Value="1" />
            <Setter Target="ContentRow.Height" Value="*" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="PageMarginStates">
        <VisualState x:Name="CompactPageMargins">
          <VisualState.Setters>
            <Setter Target="PageLayout.Padding" Value="{StaticResource CompactContentPagePadding}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardPageMargins" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid x:Name="PageLayout" MinHeight="{x:Bind PageScroller.ActualHeight, Mode=OneWay}" Padding="{StaticResource ContentPagePadding}" ColumnSpacing="{StaticResource ContentPageSpacing}" RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ContentRow" Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="RequestCard" Grid.ColumnSpan="2" Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="{StaticResource CardContentSpacing}">
          <TextBlock Text="请求" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="SlaveAddress" x:FieldModifier="public" Grid.ColumnSpan="2" Header="从站地址" Value="1" Minimum="0" Maximum="247" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
            <ComboBox x:Name="FunctionCode" x:FieldModifier="public" Grid.Column="2" Grid.ColumnSpan="2" Header="功能码" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FunctionCode_SelectionChanged">
              <x:String>03 读保持寄存器</x:String>
              <x:String>04 读输入寄存器</x:String>
              <x:String>06 写单个寄存器</x:String>
              <x:String>01 读线圈</x:String>
              <x:String>02 读离散输入</x:String>
              <x:String>05 写单个线圈</x:String>
              <x:String>0F 写多个线圈</x:String>
              <x:String>10 写多个寄存器</x:String>
              <x:String>17 读取设备标识</x:String>
            </ComboBox>
            <NumberBox x:Name="StartAddress" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="2" Header="起始地址" Value="0" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
            <NumberBox x:Name="Quantity" x:FieldModifier="public" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="数量" Value="1" Minimum="1" Maximum="125" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
            <TextBox x:Name="ValuesInput" x:FieldModifier="public" Grid.Row="2" Grid.ColumnSpan="4" Header="值列表" PlaceholderText="线圈使用 0,1；寄存器使用 10,0x0102" Visibility="Collapsed" TextChanged="ValuesInput_TextChanged" />
          </Grid>
          <TextBox x:Name="RequestPreview" x:FieldModifier="public" Header="请求帧预览" IsReadOnly="True" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Button x:Name="SendButton" x:FieldModifier="public" Content="发送请求" Click="SendButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border x:Name="ResponseCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SurfaceCardStyle}">
        <Grid RowSpacing="{StaticResource CardContentSpacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="响应解析" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBox x:Name="ResponseInput" x:FieldModifier="public" Grid.Row="1" Header="响应帧 HEX" PlaceholderText="粘贴收到的响应帧，如 01 03 02 00 0A 38 43" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Button Grid.Row="2" Content="解析响应" Click="ParseButton_Click" HorizontalAlignment="Left" />
          <ListView x:Name="RegisterList" x:FieldModifier="public" Grid.Row="3" MinHeight="320" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,4" ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Index}" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Hex}" FontFamily="{StaticResource MonospaceFontFamily}" />
                  <TextBlock Grid.Column="2" Text="{Binding DecimalText}" FontFamily="{StaticResource MonospaceFontFamily}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
      <InfoBar x:Name="Result" x:FieldModifier="public" Grid.Row="2" Grid.ColumnSpan="2" IsOpen="False" IsClosable="True" />
    </Grid>
  </ScrollView>
</Page>
