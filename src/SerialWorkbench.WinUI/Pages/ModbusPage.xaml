<Page
    x:Class="SerialWorkbench.WinUI.Pages.ModbusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls"
    NavigationCacheMode="Required">
  <ScrollView Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="20">
      <controls:PageHeader Title="Modbus RTU" Description="构造读写请求帧发送到当前串口，并解析寄存器响应。" />
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="请求" Style="{StaticResource SectionHeaderStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="SlaveAddress" x:FieldModifier="public" Header="从站地址" Value="1" Minimum="0" Maximum="247" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
            <ComboBox x:Name="FunctionCode" x:FieldModifier="public" Grid.Column="1" Header="功能码" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FunctionCode_SelectionChanged">
              <x:String>03 读保持寄存器</x:String>
              <x:String>04 读输入寄存器</x:String>
              <x:String>06 写单个寄存器</x:String>
            </ComboBox>
            <NumberBox x:Name="StartAddress" x:FieldModifier="public" Grid.Column="2" Header="起始地址" Value="0" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
            <NumberBox x:Name="Quantity" x:FieldModifier="public" Grid.Column="3" Header="数量" Value="1" Minimum="1" Maximum="125" SpinButtonPlacementMode="Compact" ValueChanged="SlaveAddress_ValueChanged" />
          </Grid>
          <TextBox x:Name="RequestPreview" x:FieldModifier="public" Header="请求帧预览" IsReadOnly="True" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Button x:Name="SendButton" x:FieldModifier="public" Content="发送请求" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="响应解析" Style="{StaticResource SectionHeaderStyle}" />
          <TextBox x:Name="ResponseInput" x:FieldModifier="public" Header="响应帧 HEX" PlaceholderText="粘贴收到的响应帧，如 01 03 02 00 0A 38 43" FontFamily="{StaticResource MonospaceFontFamily}" />
          <Button Content="解析响应" Click="ParseButton_Click" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
          <ListView x:Name="RegisterList" x:FieldModifier="public" MaxHeight="240" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,4" ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Index}" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Hex}" FontFamily="{StaticResource MonospaceFontFamily}" />
                  <TextBlock Grid.Column="2" Text="{Binding DecimalText}" FontFamily="{StaticResource MonospaceFontFamily}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
      <InfoBar x:Name="Result" x:FieldModifier="public" IsOpen="False" IsClosable="True" />
    </StackPanel>
  </ScrollView>
</Page>
