<Page
    x:Class="SerialWorkbench.WinUI.Pages.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls">
  <ScrollView Padding="40,32" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="960" Spacing="20">
      <controls:PageHeader Title="发送" Description="编写报文并发送到当前串口连接。" />
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel Spacing="14">
          <TextBox x:Name="Editor" AcceptsReturn="True" Height="260" Header="报文内容" PlaceholderText="输入文本或 HEX" TextWrapping="Wrap" VerticalContentAlignment="Top" />
          <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="Format" Header="格式" Width="180" SelectedIndex="0"><x:String>文本</x:String><x:String>HEX</x:String></ComboBox><ComboBox x:Name="LineEnding" Header="行尾" Width="180" SelectedIndex="0"><x:String>无</x:String><x:String>CR</x:String><x:String>LF</x:String><x:String>CRLF</x:String></ComboBox><Button Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/></StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollView>
</Page>
