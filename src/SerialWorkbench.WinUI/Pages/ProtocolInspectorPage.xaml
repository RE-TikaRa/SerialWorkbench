<Page x:Class="SerialWorkbench.WinUI.Pages.ProtocolInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="ProtocolInspectorPage_SizeChanged">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="PageMarginStates">
        <VisualState x:Name="CompactPageMargins">
          <VisualState.Setters>
            <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardPageMargins" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource SurfaceCardStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TemplateSelector" Header="协议模板" HorizontalAlignment="Stretch" SelectionChanged="TemplateSelector_SelectionChanged">
              <x:String>Modbus RTU</x:String>
              <x:String>自定义 JSON</x:String>
            </ComboBox>
            <TextBox x:Name="FrameInput" Grid.Column="1" Header="原始帧 HEX" PlaceholderText="输入完整帧，例如 01 03 02 00 0A 38 43" FontFamily="{StaticResource MonospaceFontFamily}" />
            <Button Grid.Column="2" Content="解析" Click="InspectButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
          </Grid>
          <TextBlock Text="原始 HEX 始终保留，解析结果只作为字段视图。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <TextBox x:Name="TemplateJson" Header="模板 JSON" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonospaceFontFamily}" Visibility="Collapsed" MinHeight="180" />
        </StackPanel>
      </Border>
      <Border x:Name="ModbusFieldsPanel" Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
        <Grid ColumnSpacing="16" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="类型" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="KindText" Text="—" Grid.Column="1" />
          <TextBlock Grid.Column="2" Text="地址" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="AddressText" Text="—" Grid.Column="3" />
          <TextBlock Grid.Row="1" Text="功能码" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="FunctionText" Text="—" Grid.Row="1" Grid.Column="1" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="帧长度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="LengthText" Text="—" Grid.Row="1" Grid.Column="3" />
          <TextBlock Grid.Row="2" Text="CRC 计算值" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="CalculatedCrcText" Text="—" Grid.Row="2" Grid.Column="1" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="CRC 实际值" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ActualCrcText" Text="—" Grid.Row="2" Grid.Column="3" />
          <TextBlock Grid.Row="3" Text="异常码" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ExceptionText" Text="—" Grid.Row="3" Grid.Column="1" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="字节数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="ByteCountText" Text="—" Grid.Row="3" Grid.Column="3" />
        </Grid>
      </Border>
      <InfoBar x:Name="Result" Grid.Row="2" IsOpen="False" IsClosable="True" Visibility="{x:Bind Result.IsOpen, Mode=OneWay}" />
      <Border x:Name="GenericFieldsPanel" Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="字段" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock x:Name="GenericFieldsText" TextWrapping="Wrap" FontFamily="{StaticResource MonospaceFontFamily}" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollView>
</Page>
