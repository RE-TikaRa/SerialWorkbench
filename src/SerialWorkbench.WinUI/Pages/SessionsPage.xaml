<Page x:Class="SerialWorkbench.WinUI.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="SessionsPage_SizeChanged"
    NavigationCacheMode="Required">
  <Grid x:Name="PageLayout" Padding="{StaticResource ContentPagePadding}" RowSpacing="{StaticResource ContentPageSpacing}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="PageMarginStates">
        <VisualState x:Name="CompactPageMargins">
          <VisualState.Setters>
            <Setter Target="PageLayout.Padding" Value="{StaticResource CompactContentPagePadding}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardPageMargins" />
      </VisualStateGroup>
      <VisualStateGroup x:Name="SessionLayoutStates">
        <VisualState x:Name="WideSessions" />
        <VisualState x:Name="CompactSessions">
          <VisualState.Setters>
            <Setter Target="SessionListColumn.Width" Value="*" />
            <Setter Target="EventListColumn.Width" Value="0" />
            <Setter Target="SessionListRow.Height" Value="2*" />
            <Setter Target="EventListRow.Height" Value="3*" />
            <Setter Target="EventPane.(Grid.Row)" Value="1" />
            <Setter Target="EventPane.(Grid.Column)" Value="0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="WorkspacePath" Text="尚未选择工作区" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

    <Grid x:Name="SessionGrid" Grid.Row="1" ColumnSpacing="{StaticResource ContentPageSpacing}" RowSpacing="{StaticResource ContentPageSpacing}">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="SessionListRow" Height="*" />
        <RowDefinition x:Name="EventListRow" Height="0" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SessionListColumn" Width="340" />
        <ColumnDefinition x:Name="EventListColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SurfaceCardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="已保存会话" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="20" Height="20" IsActive="False" />
            <Button x:Name="RevealSessionButton" Grid.Column="2" IsEnabled="False" Click="RevealSessionButton_Click" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="在文件夹中显示">
              <SymbolIcon Symbol="Folder" />
            </Button>
            <Button x:Name="RefreshSessionsButton" Grid.Column="3" Click="RefreshSessionsButton_Click" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="刷新会话">
              <SymbolIcon Symbol="Refresh" />
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <ListView x:Name="SessionList" ItemsSource="{x:Bind Sessions}" SelectionMode="Single" SelectionChanged="SessionList_SelectionChanged">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="4,6" RowSpacing="3">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SessionsEmptyState" Text="尚无会话记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="EventPane" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EventTitle" Text="选择会话以查看报文" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="DeleteSessionButton" Grid.Column="1" IsEnabled="False" Click="DeleteSessionButton_Click" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="删除会话">
              <SymbolIcon Symbol="Delete" />
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <ListView x:Name="EventList" ItemsSource="{x:Bind Events}" SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="4,5" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="82" />
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Direction}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Source}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Source}" />
                    <TextBlock Grid.Column="3" Text="{Binding Display}" FontFamily="{StaticResource MonospaceFontFamily}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Display}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EventsEmptyState" Text="选择会话以查看报文" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
