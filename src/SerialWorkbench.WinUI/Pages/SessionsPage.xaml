<Page x:Class="SerialWorkbench.WinUI.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls">
  <ScrollView Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="20">
      <controls:PageHeader Title="会话" Description="浏览和管理已保存的串口工作记录。" />

      <controls:SettingsRow Title="当前工作区" Description="选择工作区后，新的会话会保存到该位置。" Glyph="&#xE8B7;" />
      <TextBlock x:Name="WorkspacePath" x:FieldModifier="public"
          Text="尚未选择工作区"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis" />

      <controls:SettingsRow Title="活动会话" Description="连接设备后自动创建并持续记录收发数据。" Glyph="&#xE823;" />
      <TextBlock x:Name="SessionPath" x:FieldModifier="public"
          Text="尚未创建会话"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </ScrollView>
</Page>
