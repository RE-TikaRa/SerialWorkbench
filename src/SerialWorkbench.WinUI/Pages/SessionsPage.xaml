<Page x:Class="SerialWorkbench.WinUI.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">
  <ScrollView x:Name="PageScroller" Padding="{StaticResource ContentPagePadding}" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1064" Spacing="{StaticResource ContentPageSpacing}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="PageMarginStates">
          <VisualState x:Name="CompactPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PageScroller.Padding" Value="{StaticResource CompactContentPagePadding}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="StandardPageMargins">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="641" />
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel Spacing="6">
        <TextBlock Text="会话" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="浏览和管理已保存的串口工作记录。" Style="{StaticResource PageDescriptionStyle}" />
      </StackPanel>

      <toolkit:SettingsCard Header="当前工作区" Description="选择工作区后，新的会话会保存到该位置。" HorizontalContentAlignment="Stretch">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8B7;" />
        </toolkit:SettingsCard.HeaderIcon>
        <TextBlock x:Name="WorkspacePath" x:FieldModifier="public"
            Text="尚未选择工作区"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
      </toolkit:SettingsCard>

      <toolkit:SettingsCard Header="活动会话" Description="连接设备后自动创建并持续记录收发数据。" HorizontalContentAlignment="Stretch">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE823;" />
        </toolkit:SettingsCard.HeaderIcon>
        <TextBlock x:Name="SessionPath" x:FieldModifier="public"
            Text="尚未创建会话"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
      </toolkit:SettingsCard>
    </StackPanel>
  </ScrollView>
</Page>
