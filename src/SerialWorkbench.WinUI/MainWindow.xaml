<Window x:Class="SerialWorkbench.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialWorkbench.WinUI.Controls">
  <Window.SystemBackdrop><MicaBackdrop Kind="Base" /></Window.SystemBackdrop>
  <Grid x:Name="RootGrid" Background="#F7F7F7">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="SERIAL / WORKBENCH" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
      <TitleBar.IconSource><ImageIconSource ImageSource="/Assets/SerialWorkbench.ico" /></TitleBar.IconSource>
    </TitleBar>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
        <Grid Padding="14,24" RowSpacing="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="SerialWorkbench" FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"/><TextBlock Text="串口工具" FontSize="12" Foreground="#666666"/></StackPanel>
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,34,0,0">
            <TextBlock Text="主页" FontSize="12" Foreground="#666666" Margin="10,0,0,4"/>
            <NavigationView x:Name="Navigation" IsPaneOpen="True" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" Background="Transparent" SelectionChanged="Navigation_SelectionChanged">
              <NavigationView.MenuItems>
                <NavigationViewItem Content="接收" Icon="View" Tag="Receive" />
                <NavigationViewItem Content="回环检测" Icon="Refresh" Tag="Loopback" />
                <NavigationViewItem Content="会话记录" Icon="Clock" Tag="Sessions" />
              </NavigationView.MenuItems>
              <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Icon="Setting" Tag="Settings" /></NavigationView.FooterMenuItems>
            </NavigationView>
          </StackPanel>
          <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="7"><TextBlock Text="服务状态" FontSize="12" Foreground="#666666"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#107C10"/><TextBlock x:Name="ConnectionStatusText" Text="正在连接 Host…" FontSize="12" Foreground="#1A1A1A"/></StackPanel><TextBlock x:Name="CountersText" Text="RX 0 · TX 0" FontFamily="Consolas" FontSize="11" Foreground="#666666"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Frame x:Name="ContentFrame" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" NavigationFailed="ContentFrame_NavigationFailed" />
    </Grid>
    <InfoBar x:Name="HostInfoBar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" IsOpen="False" IsClosable="True" Width="360" />
  </Grid>
</Window>
