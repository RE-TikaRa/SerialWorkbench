<Application
    x:Class="SerialWorkbench.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F7F7F7" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F5F5F" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#005A9E" />
          <SolidColorBrush x:Key="TrafficReceiveBrush" Color="#63D6A0" />
          <SolidColorBrush x:Key="TrafficReceiveBackgroundBrush" Color="#1C3B35" />
          <SolidColorBrush x:Key="TrafficTransmitBrush" Color="#67C8E8" />
          <SolidColorBrush x:Key="TrafficTransmitBackgroundBrush" Color="#183946" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TrafficReceiveBrush" Color="#087F5B" />
          <SolidColorBrush x:Key="TrafficReceiveBackgroundBrush" Color="#D8F3E9" />
          <SolidColorBrush x:Key="TrafficTransmitBrush" Color="#087EA4" />
          <SolidColorBrush x:Key="TrafficTransmitBackgroundBrush" Color="#D9F0F7" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>
      <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Thickness x:Key="ContentPageMargin">0</Thickness>
      <Thickness x:Key="ContentPagePadding">0</Thickness>
      <Style TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style TargetType="NumberBox">
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style x:Key="TrafficListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <DataTemplate x:Key="TrafficRowTemplate">
        <Grid Padding="10,5" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
              VerticalAlignment="Center"
              FontFamily="Consolas"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{Binding Time}" />
          <Border
              Grid.Column="1"
              Padding="7,2"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{Binding DirectionBackground}"
              CornerRadius="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{Binding DirectionForeground}"
                Text="{Binding Direction}" />
          </Border>
          <TextBlock
              Grid.Column="2"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              Text="{Binding Display}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap"
              ToolTipService.ToolTip="{Binding Display}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
