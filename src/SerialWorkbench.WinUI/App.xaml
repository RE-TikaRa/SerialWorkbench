<Application
    x:Class="SerialWorkbench.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TrafficReceiveBrush" Color="#087F5B" />
          <SolidColorBrush x:Key="TrafficReceiveBackgroundBrush" Color="#D8F3E9" />
          <SolidColorBrush x:Key="TrafficTransmitBrush" Color="#0067C0" />
          <SolidColorBrush x:Key="TrafficTransmitBackgroundBrush" Color="#D9ECF9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TrafficReceiveBrush" Color="#63D6A0" />
          <SolidColorBrush x:Key="TrafficReceiveBackgroundBrush" Color="#1C3B35" />
          <SolidColorBrush x:Key="TrafficTransmitBrush" Color="#60CDFF" />
          <SolidColorBrush x:Key="TrafficTransmitBackgroundBrush" Color="#183946" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="TrafficReceiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="TrafficReceiveBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="TrafficTransmitBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="TrafficTransmitBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
      <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="PageDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Thickness x:Key="ContentPagePadding">24</Thickness>
      <Thickness x:Key="CompactContentPagePadding">12</Thickness>
      <x:Double x:Key="ContentPageSpacing">20</x:Double>
      <x:Double x:Key="CardContentSpacing">14</x:Double>
      <Style x:Key="TrafficListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <DataTemplate x:Key="TrafficRowTemplate">
        <Grid Padding="10,5" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
              VerticalAlignment="Center"
              FontFamily="{StaticResource MonospaceFontFamily}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{Binding Time}"
              Visibility="{Binding TimeVisibility}" />
          <Border
              Grid.Column="1"
              Padding="7,2"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{ThemeResource TrafficReceiveBackgroundBrush}"
              CornerRadius="4"
              Visibility="{Binding ReceiveVisibility}">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TrafficReceiveBrush}"
                Text="RX" />
          </Border>
          <Border
              Grid.Column="1"
              Padding="7,2"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{ThemeResource TrafficTransmitBackgroundBrush}"
              CornerRadius="4"
              Visibility="{Binding TransmitVisibility}">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TrafficTransmitBrush}"
                Text="TX" />
          </Border>
          <TextBlock
              Grid.Column="2"
              VerticalAlignment="Center"
              FontFamily="{StaticResource MonospaceFontFamily}"
              Text="{Binding Display}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap"
              ToolTipService.ToolTip="{Binding Display}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
