{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serialworkbench.local/schemas/test-sequence.schema.json",
  "title": "SerialWorkbench test sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "steps"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "connectionRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "parameters"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["send", "delay", "waitForBytes", "validateBytes", "loop", "parallel", "setVariable", "manualConfirmation"]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
