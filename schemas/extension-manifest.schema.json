{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serialworkbench.local/schemas/extension-manifest.schema.json",
  "title": "SerialWorkbench extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "entryAssembly", "capabilities"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "entryAssembly": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.dll$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": ["frameParser", "frameGenerator", "testAction"]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
