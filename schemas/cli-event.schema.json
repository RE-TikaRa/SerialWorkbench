{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serialworkbench.local/schemas/cli-event.schema.json",
  "title": "SerialWorkbench CLI event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "item"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "item": {
      "type": "object"
    }
  }
}
