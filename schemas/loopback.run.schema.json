      "--seed": {
        "type": [
          "string",
          "integer"
        ],
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "default": 5456471,
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "--pattern": {
        "enum": [
          "Fixed",
          "Incrementing",
          "Random"
